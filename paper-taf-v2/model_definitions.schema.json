{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pnovoa/cademas-app/model_definitions.schema.json",
  "title": "CADEMAS-ML model metadata",
  "description": "Metadata keyed by the exact filename of each uploaded H2O MOJO archive.",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": {
    "$ref": "#/$defs/model"
  },
  "$defs": {
    "model": {
      "type": "object",
      "required": ["performance"],
      "properties": {
        "department": {
          "type": "string",
          "minLength": 1
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "performance": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "additionalProperties": true
    }
  }
}
