{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pnovoa/cademas-app/context.schema.json",
  "title": "CADEMAS-ML context configuration",
  "type": "object",
  "required": ["rules"],
  "properties": {
    "context_name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/atomicRule"
      }
    },
    "derived_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/derivedRule"
      }
    },
    "logic": {
      "$ref": "#/$defs/logicNode"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "when": {
      "type": "object",
      "required": ["feature"],
      "properties": {
        "feature": {
          "type": "string",
          "minLength": 1
        },
        "equals": {},
        "in": {
          "type": "array",
          "minItems": 1
        }
      },
      "oneOf": [
        {
          "required": ["equals"]
        },
        {
          "required": ["in"]
        }
      ],
      "additionalProperties": false
    },
    "atomicRule": {
      "type": "object",
      "required": ["name", "feature", "type", "params"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "full_name": {
          "type": "string"
        },
        "feature": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "linear_increasing",
            "linear_decreasing",
            "triangular",
            "trapezoidal",
            "categorical_map",
            "categorical_set"
          ]
        },
        "params": {},
        "when": {
          "$ref": "#/$defs/when"
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["linear_increasing", "linear_decreasing"]
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "params": {
                "type": "array",
                "prefixItems": [
                  { "type": "number" },
                  { "type": "number" }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "triangular"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "params": {
                "type": "array",
                "prefixItems": [
                  { "type": "number" },
                  { "type": "number" },
                  { "type": "number" }
                ],
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "trapezoidal"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "params": {
                "type": "array",
                "prefixItems": [
                  { "type": "number" },
                  { "type": "number" },
                  { "type": "number" },
                  { "type": "number" }
                ],
                "minItems": 4,
                "maxItems": 4
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "categorical_map"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "categorical_set"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "ruleInput": {
      "type": "object",
      "required": ["rule"],
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "map": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "additionalProperties": false
    },
    "derivedRule": {
      "type": "object",
      "required": ["name", "op", "inputs"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "full_name": {
          "type": "string"
        },
        "op": {
          "$ref": "#/$defs/operator"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ruleInput"
          }
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "operator": {
      "enum": [
        "AVERAGE",
        "average",
        "MEAN",
        "mean",
        "MIN",
        "min",
        "MINIMUM",
        "minimum",
        "MAX",
        "max",
        "PRODUCT",
        "product",
        "PROD",
        "prod",
        "AND",
        "and",
        "OR",
        "or"
      ]
    },
    "logicNode": {
      "oneOf": [
        {
          "$ref": "#/$defs/ruleInput"
        },
        {
          "type": "object",
          "required": ["op", "inputs"],
          "properties": {
            "op": {
              "$ref": "#/$defs/operator"
            },
            "aggregation": {
              "$ref": "#/$defs/operator"
            },
            "inputs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/logicNode"
              }
            },
            "note": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
